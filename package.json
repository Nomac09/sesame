{
  "name": "sesame",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:pricing": "tsx src/lib/pricing.test.ts",
    "test:schedule": "tsx src/lib/schedule.test.ts",
    "test:reference": "tsx src/lib/reference.test.ts",
    "test:cart": "tsx src/lib/cart.test.ts",
    "test": "npm run test:pricing && npm run test:schedule && npm run test:reference && npm run test:site && npm run test:referral && npm run test:cart",
    "test:store-state": "node --conditions=react-server --env-file=.env.local --import tsx src/lib/store-state.integration.ts",
    "test:site": "tsx src/config/site.test.ts",
    "test:referral": "tsx src/config/referral.test.ts",
    "test:referral-db": "node --conditions=react-server --env-file=.env.local --import tsx src/lib/referral.integration.ts",
    "test:webhook": "node --conditions=react-server --env-file=.env.local --import tsx src/app/api/stripe/webhook/route.integration.ts",
    "test:notify": "node --conditions=react-server --env-file=.env.local --import tsx src/lib/notify.integration.ts",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node --env-file=.env.local node_modules/@playwright/test/cli.js test --ui",
    "apercu": "E2E_CAPTURE=1 node --env-file=.env.local node_modules/@playwright/test/cli.js test --project=mobile --grep @capture"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "framer-motion": "^12.42.2",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
