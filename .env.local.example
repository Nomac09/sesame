# Copier en .env.local. Ce fichier d'exemple ne contient aucun secret.
# .env* est déjà ignoré par git.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contourne RLS. Serveur uniquement, jamais exposé au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Clés de test tant que le passage en production n'est pas confirmé.
STRIPE_SECRET_KEY=sk_test_
# Fourni par `stripe listen` en local, par le dashboard en déploiement.
STRIPE_WEBHOOK_SECRET=whsec_

# --- Resend ---
RESEND_API_KEY=
# Expéditeur des confirmations client, sur un domaine vérifié chez Resend.
ORDER_EMAIL_FROM=
# Destinataire de la notification cuisine.
KITCHEN_EMAIL=

# --- Admin ---
# Seul email autorisé sur /admin. Doit être identique à la ligne insérée dans
# la table admin_emails, sinon le flux temps réel restera vide.
ADMIN_EMAIL=

# --- Site ---
# Sert à construire les URL de retour Stripe.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
